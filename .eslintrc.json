{
  "env": {
    "browser": true,
    "node": true,
    "commonjs": true,
    "es2021": true
  },
  "extends": ["airbnb-base", "prettier"],
  "globals": {
    "describe": "readonly",
    "test": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "beforeAll": "readonly",
    "afterAll": "readonly",
    "beforeEach": "readonly",
    "afterEach": "readonly",
    "vi": "readonly"
  },
  "overrides": [
    {
      "files": ["src/libs/sequelize.js"],
      "rules": { "no-console": "off" }
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "settings": {
    "import/core-modules": ["vitest/config"]
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", { "js": "never", "mjs": "always", "jsx": "never" }],
    "class-methods-use-this": 0,
    "no-param-reassign": 0
  }
}
