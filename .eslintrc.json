{
  "env": {
    "browser": true,
    "node": true,
    "commonjs": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base", "prettier"],
  "overrides": [
    {
      "files": ["src/libs/sequelize.js"],
      "rules": { "no-console": "off" }
    }
  ],
