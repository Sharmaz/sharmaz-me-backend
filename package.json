{
  "name": "sharmaz-me-backend",
  "version": "0.1.0",
  "description": "API for portfolio/resume at https://sharmaz.github.io/me/",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "rimraf coverage && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run -c vitest.config.unit.mjs --coverage",
    "test:integration": "vitest run -c vitest.config.integration.mjs --coverage",
    "test:e2e": "NODE_ENV=e2e vitest run -c vitest.config.e2e.mjs --coverage",
    "test:e2e:ci": "NODE_ENV=ci vitest run -c vitest.config.e2e.mjs",
    "lint": "eslint . --ext .js,.mjs",
    "lint-fix": "eslint --fix ./*.js",
    "migrations:generate": "sequelize-cli migration:generate --name",
    "migrations:run": "sequelize-cli db:migrate",
    "migrations:revert": "sequelize-cli db:migrate:undo",
    "migrations:delete": "sequelize-cli db:migrate:undo:all",
    "migrations:seed:generate": "sequelize-cli seed:generate --name",
    "migrations:run:seed": "sequelize-cli db:seed:all",
    "migrations:seed:revert": "sequelize-cli db:seed:undo",
    "migrations:seed:delete": "sequelize-cli db:seed:undo:all",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:lint": "cd client && npm run lint",
    "client:lint-fix": "cd client && npm run lint-fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharmaz/sharmaz-me-backend.git"
  },
  "author": "Ivan Robles <irae45@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Sharmaz/sharmaz-me-backend/issues"
  },
  "homepage": "https://github.com/Sharmaz/sharmaz-me-backend#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^8.44.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "nodemon": "3.1.14",
    "prettier": "^2.8.8",
    "sequelize-cli": "^6.6.1",
    "supertest": "^6.3.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.6.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "sequelize": "6.37.8",
    "umzug": "^3.3.1"
  }
}
